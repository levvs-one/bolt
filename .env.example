# Домены. Оба должны указывать A-записью на этот сервер: Caddy сам выпустит сертификаты.
PANEL_DOMAIN=panel.example.com
SUBSCRIPTION_DOMAIN=sub.example.com
# Адрес ссылок подписки, которые выдаёт панель. Без http:// и без / в конце.
SUB_PUBLIC_DOMAIN=sub.example.com
FRONT_END_DOMAIN=panel.example.com

# Панель
APP_PORT=3000
METRICS_PORT=3001
API_INSTANCES=1
APP_SECRET=change_me
METRICS_USER=admin
METRICS_PASS=change_me

# База и Valkey
POSTGRES_USER=bolt
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bolt
DATABASE_URL=postgresql://bolt:change_me@bolt-db:5432/bolt
REDIS_SOCKET=/var/run/valkey/valkey.sock

# Страница подписки. Токен выпускается в панели: Настройки, Токены API.
SUBSCRIPTION_PAGE_API_TOKEN=
SUBSCRIPTION_PAGE_JWT_SECRET=change_me

# Уведомления в Telegram, по желанию
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
